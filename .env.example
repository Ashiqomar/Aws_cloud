# ──────────────────────────────────────────────
# FinOps Platform — Environment Variables
# Copy to .env and fill in your values
# ──────────────────────────────────────────────

# Application
APP_NAME=FinOps Cloud Cost Optimizer
DEBUG=true

# Database  (Supabase or local PostgreSQL)
# For Supabase: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# For local:    postgresql://postgres:password@localhost:5432/finops
DATABASE_URL=postgresql://postgres:password@localhost:5432/finops

# Redis  (Celery broker & result backend)
REDIS_URL=redis://localhost:6379/0

# AWS  (default region for SDK calls)
AWS_DEFAULT_REGION=us-east-1

# Gemini AI API Key (optional — fallback FinOps analyzer used if blank)
GEMINI_API_KEY=your_gemini_api_key_here
